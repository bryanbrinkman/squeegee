# Copy to .env.local (static upload) or add in Vercel → Settings → Environment Variables.

# Network the edition lives on. Ethereum = 1, Base = 8453,
# Base Sepolia (testnet) = 84532, Sepolia (testnet) = 11155111.
NEXT_PUBLIC_CHAIN_ID=1
NEXT_PUBLIC_CHAIN_NAME=Ethereum
# A PUBLIC, keyless RPC. This ships to every visitor's browser, so never use a
# URL with an API key in it. Comma-separate several for failover.
#   Ethereum      https://ethereum-rpc.publicnode.com
#   Base          https://mainnet.base.org
#   Base Sepolia  https://sepolia.base.org
NEXT_PUBLIC_RPC_URL=https://ethereum-rpc.publicnode.com

# Your edition's contract address from `abx deploy-code`. Leave empty until
# then: the page shows the live preview and "Not on sale yet".
NEXT_PUBLIC_TOKEN=

# Optional. Only set NEXT_PUBLIC_BASE_PATH when the site lives in a subfolder,
# e.g. /paint-smear for bryanbrinkman.com/paint-smear (no trailing slash).
NEXT_PUBLIC_BASE_PATH=
# NEXT_PUBLIC_MINTER defaults to ABX's shared 1155 minter,
# 0x2af9f0c477c34a23cBeC646a3b6BC0cA4Df5d37f, and NEXT_PUBLIC_EXPLORER is
# picked from the chain id. Override only if you know you need to.
